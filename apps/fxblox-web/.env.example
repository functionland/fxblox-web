# Copy to .env.local for local overrides. All values are optional; defaults are the production endpoints.

# Blox hotspot API (go-fula WAP server). Playwright / fake-blox uses http://127.0.0.1:3500.
VITE_BLOX_AP_URL=http://10.42.0.1:3500

# Cloud services
VITE_DISCOVERY_URL=https://discovery.fula.network
VITE_POOLS_URL=https://pools.fx.land
VITE_AI_TRAINING_URL=https://ai-training.fx.land

# Reown AppKit (WalletConnect) project id
VITE_REOWN_PROJECT_ID=94a4ca39db88ee0be8f6df95fdfb560a

# Feature flags (true/false)
# Blox AI over Bluetooth — off until fula-ota PR-E (bluetooth.py ai/* manifest) ships
VITE_ENABLE_BLE_AI=false
# Fragment >512-byte BLE commands as `chunk <n>/<m> <payload>` — off until PR-E ships
VITE_ENABLE_BLE_CHUNKED_WRITES=false
# Settings › Blox logs page (hidden on mobile too)
VITE_ENABLE_BLOX_LOGS=false
# /gallery route (DEV-only by default)
VITE_ENABLE_GALLERY=false
# Skip LAN HTTP entirely and use Web Bluetooth for setup ("Prefer Bluetooth" build)
VITE_FORCE_BLE=false

# Build-time relay WebTransport multiaddrs with certhash (comma separated), refreshed by tools/relay-probe
VITE_RELAY_WT_ADDRS=

# Vite base path (deploy.yml sets this from PAGES_CNAME)
VITE_BASE=/
