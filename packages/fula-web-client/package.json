{
  "name": "@functionland/fula-web-client",
  "version": "0.0.1",
  "description": "Browser (js-libp2p) client for go-fula Blox actions — mirrors @functionland/react-native-fula's fula / blockchain / fxblox namespaces",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/createNodeNode.ts",
    "./http": "./src/core/httpOverStream.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.12",
    "@libp2p/crypto": "^5.1.0",
    "@libp2p/identify": "^4.1.13",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/peer-id": "^6.0.0",
    "@libp2p/ping": "^3.1.12",
    "@libp2p/webtransport": "^6.0.36",
    "@multiformats/multiaddr": "^13.0.3",
    "@multiformats/multiaddr-matcher": "^3.0.2",
    "it-length-prefixed": "^11.0.1",
    "libp2p": "^3.3.9",
    "p-defer": "^4.0.1",
    "uint8arraylist": "^3.0.2",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@libp2p/tcp": "^11.0.27",
    "@libp2p/websockets": "^10.1.20",
    "vitest": "^3.0.0"
  }
}
