{
  "name": "@functionland/fx-ui",
  "version": "0.0.1",
  "description": "FxBlox web design system — Fx tokens (from libs/component-library theme.ts) on Tailwind v4 + Radix primitives",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/theme.css"
  },
  "sideEffects": [
    "*.css"
